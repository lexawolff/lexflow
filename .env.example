# Copie este arquivo para .env e preencha os valores.
# Nunca versione o .env: ele contém segredos.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# ============================================================
# BANCO DE DADOS (Supabase > Connect > ORMs/Prisma)
# ============================================================

# Conexão do app. Em servidor na nuvem (Vercel), use o pooler em modo
# TRANSAÇÃO (porta 6543) com pgbouncer=true e connection_limit=1:
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão das migrations (prisma migrate). Pooler em modo SESSÃO (porta 5432):
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============================================================
# SUPABASE (Supabase > Project Settings > API Keys)
# ============================================================

NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"

# Chave pública (anon/publishable). Pode ir ao navegador: o banco tem RLS
# em todas as tabelas e o Storage não tem políticas públicas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Chave secreta (service_role). SOMENTE no servidor. Usada para o Storage
# e para criar contas de membros convidados.
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================================
# CRIPTOGRAFIA DO LEXFLOW
# Guarde cópias seguras: sem elas os dados cifrados ficam ilegíveis.
# Não troque em um banco que já tem dados cifrados.
# ============================================================

# Senhas Gov.br dos clientes (qualquer texto longo e aleatório).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Tokens do Google Agenda (exatamente 32 bytes em base64).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# ============================================================
# GOOGLE AGENDA (Google Cloud Console > APIs e serviços > Credenciais)
# ============================================================

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Precisa estar cadastrado nas URIs de redirecionamento autorizadas do OAuth.
# Local: http://localhost:3000/api/google-calendar/callback
# Produção: https://SEU_DOMINIO/api/google-calendar/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"
