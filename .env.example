# Copie este arquivo para .env e preencha os valores.
# Nunca versione o .env: ele contém segredos.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.

# ============================================================
# BANCO DE DADOS (Supabase > Connect > ORMs/Prisma)
# ============================================================

# Conexão do app. Em servidor na nuvem (Vercel), use o pooler em modo
# TRANSAÇÃO (porta 6543) com pgbouncer=true e connection_limit=1:
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão das migrations (prisma migrate). Pooler em modo SESSÃO (porta 5432):
DIRECT_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ============================================================
# SUPABASE (Supabase > Project Settings > API Keys)
# ============================================================

NEXT_PUBLIC_SUPABASE_URL="https://SEU_PROJETO.supabase.co"

# Chave pública (anon/publishable). Pode ir ao navegador: o banco tem RLS
# em todas as tabelas e o Storage não tem políticas públicas.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Chave secreta (service_role). SOMENTE no servidor. Usada para o Storage
# e para criar contas de membros convidados.
SUPABASE_SERVICE_ROLE_KEY=""

# ============================================================
# CRIPTOGRAFIA DO LEXFLOW
# Guarde cópias seguras: sem elas os dados cifrados ficam ilegíveis.
# Não troque em um banco que já tem dados cifrados.
# ============================================================

# Senhas Gov.br dos clientes (qualquer texto longo e aleatório).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Tokens do Google Agenda e CPF/CNPJ do cadastro (exatamente 32 bytes em base64).
# Trocar esta chave também desfaz a trava de um cadastro por CPF/CNPJ.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=""

# ============================================================
# GOOGLE AGENDA (Google Cloud Console > APIs e serviços > Credenciais)
# ============================================================

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Precisa estar cadastrado nas URIs de redirecionamento autorizadas do OAuth.
# Local: http://localhost:3000/api/google-calendar/callback
# Produção: https://app.lexflowjuridico.com.br/api/google-calendar/callback
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"

# ============================================================
# CADASTRO PÚBLICO DE ESCRITÓRIOS (/cadastro)
# ============================================================

# Em desenvolvimento fica ligado por padrão ("false" desliga).
# Em produção fica DESLIGADO até "true" — ative só depois de configurar
# SMTP, confirmação de e-mail e termos de uso. Desligar de novo funciona
# como botão de emergência contra cadastros abusivos.
SIGNUP_ENABLED="false"

# Só em desenvolvimento: "false" volta a enviar o e-mail de confirmação.
# Por padrão, o link aparece na tela e nenhum e-mail é enviado.
# SIGNUP_DEV_CONFIRM_LINK="false"

# Protege as rotinas diárias da Vercel: limpeza de cadastros não confirmados
# e avisos e exclusão de testes vencidos.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=""

# ============================================================
# E-MAILS ENVIADOS PELO SISTEMA (Resend)
# ============================================================

# Chave do Resend com permissão só de envio (Resend > API Keys).
RESEND_API_KEY=""

# Endereço público do sistema, usado nos links dos e-mails das rotinas.
# Produção: https://app.lexflowjuridico.com.br
APP_URL="http://localhost:3000"

# ============================================================
# COBRANÇA DAS ASSINATURAS (Asaas)
# ============================================================

# Testes: https://api-sandbox.asaas.com/v3 com chave $aact_hmlg_...
# Produção: https://api.asaas.com/v3 com chave $aact_prod_...
# A chave começa com $: no .env, escreva uma barra antes (\$aact_...),
# senão o Next.js tenta ler o resto como outra variável.
ASAAS_API_KEY=""
ASAAS_API_URL="https://api-sandbox.asaas.com/v3"

# Token dos avisos (webhooks) do Asaas: o mesmo texto vai no campo
# "Token de autenticação" do webhook no painel do Asaas. Nunca a chave da API.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ASAAS_WEBHOOK_TOKEN=""

# ============================================================
# DADOS DO FORNECEDOR (Termos de Uso e Política de Privacidade)
# Aparecem nas páginas públicas /termos e /privacidade.
# Ficam fora do código para não irem ao repositório.
# Sem eles, as páginas mostram aviso de minuta e o cadastro
# público não abre em produção.
# ============================================================

LEGAL_PROVIDER_NAME=""
LEGAL_PROVIDER_CPF=""
LEGAL_PROVIDER_ADDRESS=""
LEGAL_PROVIDER_FORUM=""
