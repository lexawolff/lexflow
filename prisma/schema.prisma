generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum WorkItemStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

enum WorkPlanningPeriod {
  ESTA_SEMANA
  ESTE_MES
  DEPOIS
}

enum CaseOrigin {
  ADMINISTRATIVO
  JUDICIAL
  AMBOS
}

enum AdministrativeStatus {
  NAO_APLICAVEL
  REQUERIDO
  EM_ANALISE
  DEFERIDO
  INDEFERIDO
  RECURSO
}

enum TaskType {
  PRAZO_PROCESSUAL
  PRORROGACAO_BENEFICIO
  ATENDIMENTO
  AUDIENCIA
  PERICIA
  DOCUMENTO_PENDENTE
  CONTATO_CLIENTE
  RPV
  OUTRO
}

enum UserRole {
  OWNER
  ADMIN
  LAWYER
  INTERN
  FINANCIAL
  VIEWER
}

enum PracticeArea {
  PREVIDENCIARIO
  CIVEL
  FAMILIA
  TRABALHISTA
  CONSUMIDOR
  ADMINISTRATIVO
  TRIBUTARIO
  EMPRESARIAL
  CRIMINAL
  OUTRO
}

enum CaseStatus {
  ATENDIMENTO_INICIAL
  DOCUMENTACAO_PENDENTE
  ADMINISTRATIVO
  INICIAL_EM_ELABORACAO
  PROTOCOLADO
  AGUARDANDO_PERICIA
  AGUARDANDO_SENTENCA
  RECURSO
  CUMPRIMENTO_SENTENCA
  RPV_EXPEDIDA
  RPV_PAGA
  ENCERRADO
}

enum FinancialStatus {
  PENDENTE
  PAGO
  ATRASADO
  PARCIAL
  CANCELADO
}

enum RpvStatus {
  AGUARDANDO_EXPEDICAO
  EXPEDIDA
  AUTUADA
  LIBERADA
  PAGA
  CANCELADA
}

enum RpvType {
  RPV
  PRECATORIO
}

enum TaskStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
  ATRASADA
}

enum TaskSource {
  LEXFLOW
  GOOGLE_CALENDAR
}

enum ExtraServiceStatus {
  A_RECEBER
  RECEBIDO
  CANCELADO
}

enum DocumentCategory {
  RG
  CPF
  CNIS
  CTPS
  COMPROVANTE_RESIDENCIA
  LAUDO
  EXAME
  RECEITA
  ATESTADO
  CONTRATO
  PROCURACAO
  PETICAO
  SENTENCA
  ACORDAO
  OUTRO
}

enum ReceivableType {
  HONORARIO_CONTRATUAL
  HONORARIO_SUCUMBENCIAL
  RPV
  ACORDO
  CONSULTA
  SERVICO_EXTRA
  OUTRO
}

enum PayableCategory {
  ALUGUEL
  SALARIO
  IMPOSTO
  SOFTWARE
  MARKETING
  MATERIAL_ESCRITORIO
  CUSTAS
  OUTRO
}

enum TimelineEntityType {
  CLIENT
  CASE
  DOCUMENT
  FINANCIAL
  TASK
  NOTE
}

enum TimelineEventType {
  CLIENT_CREATED
  CLIENT_UPDATED

  CASE_CREATED
  CASE_UPDATED
  CASE_STATUS_CHANGED

  DOCUMENT_UPLOADED
  DOCUMENT_DELETED

  FINANCIAL_CREATED
  FINANCIAL_UPDATED
  FINANCIAL_PAID

  TASK_CREATED
  TASK_COMPLETED

  NOTE_CREATED

  SYSTEM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

//
// USER
//

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]

  googleCalendarConnections GoogleCalendarConnection[]
}

//
// WORKSPACE
//

model Workspace {
  id String @id @default(uuid())

  //
  // IDENTIFICAÇÃO
  //

  name      String
  slug      String  @unique
  legalName String?

  //
  // DADOS PROFISSIONAIS
  //

  cnpj            String?
  oabRegistration String?
  oabState        String?

  //
  // CONTATO
  //

  email    String?
  phone    String?
  whatsapp String?
  website  String?

  //
  // ENDEREÇO
  //

  cep           String?
  address       String?
  addressNumber String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?

  //
  // CONTROLE
  //

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //
  // RELAÇÕES
  //

  members Membership[]

  clients Client[]
  cases   Case[]

  subscription   Subscription?
  billingProfile BillingProfile?

  payables    Payable[]
  receivables Receivable[]
  rpvs        Rpv[]
  tasks       Task[]
  workItems   WorkItem[]

  extraServices ExtraService[]

  documents Document[]

  clientEvents              ClientEvent[]
  caseEvents                CaseEvent[]
  googleCalendarConnections GoogleCalendarConnection[]
}

//
// MEMBERSHIP
//

model Membership {
  id String @id @default(uuid())

  userId      String
  workspaceId String

  role UserRole @default(OWNER)

  // ==========================
  // PREFERÊNCIAS DO USUÁRIO NO ESCRITÓRIO
  // ==========================

  agendaShowCompleted Boolean @default(true)
  agendaDefaultStatus String  @default("TODOS")
  agendaItemsPerDay   Int     @default(4)
  agendaShowAttention Boolean @default(true)

  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  workItems WorkItem[]

  @@unique([userId, workspaceId])
  @@index([userId])
}

//

model TimelineEvent {
  id          String @id @default(cuid())
  workspaceId String
  clientId    String

  type        TimelineEventType
  title       String
  description String?

  entityType TimelineEntityType?
  entityId   String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientId])
  @@index([clientId, createdAt])
  @@index([entityType, entityId])
}

//

model Client {
  id          String @id @default(uuid())
  workspaceId String

  // ==========================
  // Dados pessoais
  // ==========================

  name String

  cpf String?
  rg  String?

  birthDate DateTime?

  motherName String?
  fatherName String?

  gender        String?
  maritalStatus String?

  nationality String?
  education   String?

  profession String?
  income     Float?

  // ==========================
  // Contato
  // ==========================

  phone    String?
  whatsapp String?
  email    String?

  // ==========================
  // Endereço
  // ==========================

  cep           String?
  address       String?
  addressNumber String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?

  // ==========================
  // Previdenciário
  // ==========================

  pis String?

  // ==========================
  // Gov.br
  // ==========================

  govLogin             String?
  govPasswordEncrypted String? @db.Text

  // ==========================
  // Observações
  // ==========================

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  cases          Case[]
  documents      Document[]
  receivables    Receivable[]
  events         ClientEvent[]
  tasks          Task[]
  workItems      WorkItem[]
  timelineEvents TimelineEvent[]

  @@index([workspaceId])
  @@index([name])
  @@index([cpf])
}

//
// CASE
//

model Case {
  id String @id @default(uuid())

  workspaceId String
  clientId    String

  // Identificação

  title        String
  practiceArea PracticeArea
  subject      String?
  benefitType  String?

  // Origem

  origin               CaseOrigin           @default(JUDICIAL)
  administrativeStatus AdministrativeStatus @default(NAO_APLICAVEL)

  // Numeração

  number                String?
  administrativeNumber  String?
  administrativeProcess String?

  // Órgão julgador

  court     String?
  courtUnit String?
  judge     String?
  city      String?
  state     String?

  // Partes

  opposingParty String?

  // Financeiro

  claimValue Decimal?

  // Situação

  status CaseStatus @default(ATENDIMENTO_INICIAL)

  // Datas

  administrativeRequestDate DateTime?
  distributionDate          DateTime?
  nextDeadline              DateTime?

  // Observações

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)

  receivables Receivable[]
  rpvs        Rpv[]
  events      CaseEvent[]
  tasks       Task[]
  workItems   WorkItem[]

  @@index([workspaceId])
  @@index([clientId])
  @@index([number])
  @@index([administrativeNumber])
  @@index([status])
  @@index([practiceArea])
  @@index([origin])
}

//
// PAYABLE
//

model Payable {
  id String @id @default(uuid())

  workspaceId String

  description String

  category PayableCategory @default(OUTRO)

  amount Decimal

  dueDate DateTime

  paidAt DateTime?

  status FinancialStatus @default(PENDENTE)

  paymentMethod String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([dueDate])
  @@index([status])
  @@index([category])
}

//
// RECEIVABLE
//

model Receivable {
  id String @id @default(uuid())

  workspaceId String
  clientId    String
  caseId      String?
  rpvId       String?

  description String
  type        ReceivableType @default(HONORARIO_CONTRATUAL)

  totalAmount Decimal
  paidAmount  Decimal @default(0)

  dueDate    DateTime?
  receivedAt DateTime?

  status FinancialStatus @default(PENDENTE)

  paymentMethod String?
  notes         String?

  originalDueDate DateTime?

  installmentGroupId String?
  installmentNumber  Int?
  totalInstallments  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  rpv Rpv? @relation(fields: [rpvId], references: [id], onDelete: Cascade)

  @@unique([rpvId, type])
  @@index([workspaceId])
  @@index([clientId])
  @@index([caseId])
  @@index([rpvId])
  @@index([status])
  @@index([type])
  @@index([dueDate])
  @@index([installmentGroupId])
}

//
// RPV
//

model Rpv {
  id String @id @default(uuid())

  workspaceId String

  caseId String

  type RpvType @default(RPV)

  requisitionNumber String?

  court String?

  grossAmount Decimal

  contractualFeeRate Decimal?

  contractualFeeValue Decimal?

  sucumbencyFeeValue Decimal?

  clientNetAmount Decimal?

  expectedPaymentDate DateTime?

  paidAt DateTime?

  bank String?

  status RpvStatus @default(AGUARDANDO_EXPEDICAO)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  receivables Receivable[]

  @@index([workspaceId])
  @@index([caseId])
  @@index([type])
  @@index([expectedPaymentDate])
  @@index([status])
}

//
// TASK
//

model Task {
  id          String  @id @default(uuid())
  workspaceId String
  clientId    String?
  caseId      String?

  title       String
  description String?

  type   TaskType
  status TaskStatus @default(PENDENTE)

  // ==========================
  // Agenda
  // ==========================

  startsAt DateTime?
  endsAt   DateTime?
  dueDate  DateTime

  completedAt DateTime?

  location String?

  // ==========================
  // Origem
  // ==========================

  source TaskSource @default(LEXFLOW)

  // ==========================
  // Google Calendar
  // ==========================

  googleConnectionId String?
  googleCalendarId   String?
  googleEventId      String?

  // ==========================
  // Controle
  // ==========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  case Case? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  googleConnection GoogleCalendarConnection? @relation(fields: [googleConnectionId], references: [id], onDelete: SetNull)

  @@unique([googleConnectionId, googleEventId])
  @@index([workspaceId])
  @@index([clientId])
  @@index([caseId])
  @@index([dueDate])
  @@index([startsAt])
  @@index([endsAt])
  @@index([status])
  @@index([type])
  @@index([source])
  @@index([googleConnectionId])
  @@index([googleEventId])
}

model WorkItem {
  id                     String  @id @default(uuid())
  workspaceId            String
  clientId               String?
  caseId                 String?
  assignedToMembershipId String

  // ==========================
  // Trabalho
  // ==========================

  title       String
  description String?

  status WorkItemStatus     @default(PENDENTE)
  period WorkPlanningPeriod @default(ESTA_SEMANA)

  // Quanto menor, mais acima aparece na fila
  position Int @default(0)

  // Prazo real, quando existir
  dueDate DateTime?

  completedAt DateTime?

  // ==========================
  // Controle
  // ==========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ==========================
  // Relações
  // ==========================

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  case       Case?      @relation(fields: [caseId], references: [id], onDelete: SetNull)
  assignedTo Membership @relation(fields: [assignedToMembershipId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientId])
  @@index([caseId])
  @@index([status])
  @@index([period])
  @@index([position])
  @@index([dueDate])
  @@index([workspaceId, period, status, position])
  @@index([assignedToMembershipId])
}

//
// GOOGLE CALENDAR
//

model GoogleCalendarConnection {
  id String @id @default(uuid())

  workspaceId String
  userId      String

  // ==========================
  // Conta Google
  // ==========================

  googleAccountEmail String?

  calendarId String @default("primary")

  // ==========================
  // OAuth
  // ==========================

  refreshTokenEncrypted String @db.Text

  // ==========================
  // Sincronização
  // ==========================

  syncToken String? @db.Text

  syncFromGoogle Boolean @default(true)
  syncToGoogle   Boolean @default(true)

  lastSyncedAt DateTime?

  // ==========================
  // Push Google -> LexFlow
  // ==========================

  watchChannelId  String?   @unique
  watchResourceId String?
  watchExpiresAt  DateTime?

  // ==========================
  // Controle
  // ==========================

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

//
// EXTRA SERVICE
//

model ExtraService {
  id String @id @default(uuid())

  workspaceId String

  description String

  serviceType String

  date DateTime

  amount Decimal

  status ExtraServiceStatus @default(A_RECEBER)

  paidAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([date])
  @@index([status])
}

//
// DOCUMENT
//

model Document {
  id String @id @default(uuid())

  workspaceId String

  clientId String

  originalName String

  category DocumentCategory?

  storagePath String

  fileType String?

  size Int

  uploadedBy String?

  createdAt DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientId])
  @@index([category])
}

//
// CLIENT EVENT
//

model ClientEvent {
  id String @id @default(uuid())

  workspaceId String

  clientId String

  title String

  content String?

  date DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([clientId])
}

//
// CASE EVENT
//

model CaseEvent {
  id String @id @default(uuid())

  workspaceId String

  caseId String

  title String

  content String?

  date DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([caseId])
}

//
// SUBSCRIPTION
//

model Subscription {
  id String @id @default(uuid())

  workspaceId String @unique

  //
  // PLANO
  //

  planCode String?
  planName String?

  status SubscriptionStatus @default(TRIALING)

  billingInterval BillingInterval?

  amountCents Int?
  currency    String @default("BRL")

  //
  // PERÍODO
  //

  trialEndsAt DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?

  cancelAtPeriodEnd Boolean   @default(false)
  canceledAt        DateTime?

  //
  // PROVEDOR DE PAGAMENTO
  //

  provider               String?
  providerCustomerId     String?
  providerSubscriptionId String?
  providerPriceId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status])
}

//
// BILLING PROFILE
//

model BillingProfile {
  id String @id @default(uuid())

  workspaceId String @unique

  //
  // IDENTIFICAÇÃO
  //

  name  String?
  taxId String?

  //
  // CONTATO
  //

  email String?
  phone String?

  //
  // ENDEREÇO DE COBRANÇA
  //

  cep           String?
  address       String?
  addressNumber String?
  complement    String?
  neighborhood  String?
  city          String?
  state         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

// Auditoria de credenciais: somente identificadores e ações, nunca valores.
enum AuditAction {
  GOV_PASSWORD_RELEASED_FOR_REVEAL
  GOV_PASSWORD_RELEASED_FOR_COPY
  GOV_PASSWORD_COPY_REPORTED
  GOV_CREDENTIAL_CREATED
  GOV_CREDENTIAL_UPDATED
}

model AuditLog {
  id            String      @id @default(uuid())
  workspaceId   String
  actorUserId   String
  clientId      String
  action        AuditAction
  parentEventId String?     @unique
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  // IDs históricos sem cascade: excluir cliente/membro não apaga a auditoria.
  // Validação de usuário e escritório ocorre nas Server Actions.
  @@index([workspaceId, createdAt])
  @@index([workspaceId, clientId, createdAt])
  @@index([workspaceId, actorUserId, createdAt])
}
